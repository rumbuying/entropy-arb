# secrets & local config / 密钥与本地配置
.env
config.yaml

# runtime output / 运行时输出
logs/
*.log

# console v2 persistent storage / 控制台 V2 持久化数据库
data/

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/

# console running-profile markers (runtime state) / 控制台运行中的 profile 标记
profiles/*.lock

# console auto-generated token / 控制台自动生成的令牌
logs/console-token

# macOS junk
.DS_Store

# local-only docs (machine-specific manual, not for the public repo)
docs/

# console token env (real token lives here, never committed) / 控制台真实 token
deploy/*.env
Pendle_Proxy.pem
.zcode/
